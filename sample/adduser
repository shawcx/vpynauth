#!/usr/bin/env python3

# simple script to generate a password, only supports adding new users

import sys
import getpass

from vpyn import USERS, hash_password, load_users

if len(sys.argv) != 2:
	print(f'Usage: {sys.argv[0]} <username>')
	sys.exit(1)

users = load_users()

user = sys.argv[1]

if user in users:
	print(f'User "{user}" already present')
	sys.exit(0)

pass1 = getpass.getpass('Password: ')
pass2 = getpass.getpass('Verify: ')

if pass1 != pass2:
	print(f'Passwords do not match')
	sys.exit(1)

password = hash_password(pass1.encode('utf-8', 'surrogateescape'))

with open(USERS, 'a') as fp:
	fp.write(f'{user},{password}\n')
